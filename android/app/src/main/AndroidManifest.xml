<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- CIAM login redirect callback — must match NATIVE_REDIRECT_URI in
                 libs/shared/iam-msal-external/src/services/msal-external-auth.service.ts and the
                 redirect URI registered on the Members app registration in Entra External ID. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="auth-callback" />
            </intent-filter>

            <!-- Gateway checkout return (academy fee and carnet alike) — matched by DeepLinkService's
                 PAYMENT_CALLBACK_PREFIX (src/app/core/native/deep-link.service.ts). Android's intent-filter
                 data matching is host-scoped (unlike iOS's Info.plist, which only registers the
                 scheme), so this needs its own filter entry, not just a second <data> host under
                 the auth-callback filter above. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="payment-callback" />
            </intent-filter>

            <!-- Parent-invitation deep link (Modules.Academy). Custom-scheme fallback host, matched
                 by DeepLinkService's INVITE_SCHEME_PREFIX; the backend landing page
                 (AcademyInviteController) redirects the mobile browser here. Its own filter entry
                 because Android intent-filter data matching is host-scoped. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="invite" />
            </intent-filter>

            <!-- Same link as an Android App Link: once verified (blocked today on the release
                 signing cert / Play App Signing — the /.well-known/assetlinks.json served by the
                 backend has no fingerprint yet), the https URL opens the app directly and the
                 landing page above is only shown when the app is not installed. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="api.localbiz.pl" android:pathPrefix="/api/academy/invite" />
            </intent-filter>

            <!-- The invitation e-mail's own link — the AcademyWeb portal's /invite page. Verified the same
                 way, against https://academy.localbiz.pl/.well-known/assetlinks.json (needs the release
                 signing cert fingerprint, see above); until then the e-mail link opens the web portal. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="academy.localbiz.pl" android:pathPrefix="/invite" />
            </intent-filter>

            <!-- One-time carnet renewal link from the Carnets reminder job — opens the classes section. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="carnet" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- @capacitor-mlkit/barcode-scanning — required so the plugin's ready-to-use scan() UI can
             download the barcode_ui ML Kit model on demand (see manual-join.component.ts). -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- @capacitor/geolocation — "find a club" discovery sorts by distance when granted, falls back
         to alphabetical sorting otherwise (see storefront-discovery.service.ts). Coarse is enough for
         a 30km club-radius search; fine is requested too since the plugin's permission prompt bundles
         both and Android doesn't let an app ask for "coarse only" via this API. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- @capacitor-mlkit/barcode-scanning — scanning a club's QR code to join it (manual-join.component.ts). -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
